# ─────────────────────────────────────────────────────────────
# Required by the deployed app (main.js) — set these in Vercel
# ─────────────────────────────────────────────────────────────

# LINE Messaging API
LINE_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Bypasses RLS — used only by the /admin/api/* routes (roster CRUD, access
# requests). Physician auth (email OTP + LINE binding) never touches this key
# at all: that lives in the Supabase Edge Function
# (supabase/functions/line-verify), which gets its own service-role key
# injected automatically by the Edge Functions runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Local dev only — Vercel provides PORT automatically
# PORT=3000

# The admin's Telegram alert for a LIFF upload (design §7.6). /upload/score
# scores, saves and closes the queue row inside the Vercel request, so the
# worker never sees the common case and cannot report it — these two are what
# make that submission audible. Missing values are not an error: the send is
# skipped with a console warning and the physician's receipt is unaffected.
#
# Same bot and same chat as automation/telegram.js, which holds its own copy
# as a GitHub Actions secret (see automation/.env.example) — this is a second
# deployment needing the same credential, not a second credential.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# NOTE: the Telegram *access-request* alert is a different sender again — a
# Supabase DB trigger (scripts/notify-access-request.sql) reading its own copy
# from Supabase Vault. It does not use the variables above.

# ─────────────────────────────────────────────────────────────
# Required by supabase/functions/line-verify (set via `supabase secrets set`,
# NOT here — this file only documents Vercel/main.js env vars)
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are injected
# automatically for every Edge Function — nothing to set for those. The one
# secret the function needs configured explicitly:
#
#   supabase secrets set LINE_LOGIN_CHANNEL_ID=xxxxxxxxxx
#
# The channel id of the LINE **Login** channel that owns the /verify/ LIFF
# app — NOT the Messaging API channel above. Sent as `client_id` to
# https://api.line.me/oauth2/v2.1/verify, which is how LINE checks the ID
# token's audience.
#
# LINE binding is traceability only, not a login requirement — see
# scripts/auth-rewrite-2026-08.sql — so this being unset just means new LINE
# bindings silently stop recording; it does not lock anyone out. Still,
# functional binding needs the /verify/ LIFF app's `openid` scope enabled
# in the LINE Developers console, or liff.getIDToken() returns null and
# there's nothing for the function to verify.

# ─────────────────────────────────────────────────────────────
# Drive destinations for the process/ pipeline (GitHub Actions secrets)
# ─────────────────────────────────────────────────────────────
# Both were hardcoded in process/*.js while this repository was public, which
# published a direct address for two folders shared "anyone with the link".
# A folder id is a locator rather than a secret, so moving it here is hygiene —
# what actually closes the exposure is removing the public sharing on the
# folders themselves. Both scripts now exit non-zero when the value is missing
# rather than defaulting somewhere unintended.
#
# P4P_REPORT_FOLDER_ID=      # process/report.js — outstanding-submissions list
# P4P_ELIGIBLE_FOLDER_ID=    # process/eligible-list.js — monthly eligible PDF

# ─────────────────────────────────────────────────────────────
# Only for the admin scripts in scripts/ (NOT needed by the app)
# ─────────────────────────────────────────────────────────────
# LINE_TOKEN=        # setup-richmenu.mjs, update-month-picker.mjs
# LINE_USER_ID=      # send-test-flex.mjs
