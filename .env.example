# ─────────────────────────────────────────────────────────────
# Required by the deployed app (main.js) — set these in Vercel
# ─────────────────────────────────────────────────────────────

# LINE Messaging API
LINE_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# Telegram approve/reject buttons on new access requests (optional feature —
# see scripts/telegram-approve-buttons.sql). Leave unset to disable the
# /telegram/webhook handler's effects.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Bypasses RLS — used by the /telegram/webhook handler to act on
# access_requests / physician_directory on the admin's behalf, and by
# /line/bind to write the server-verified LINE binding.
SUPABASE_SERVICE_ROLE_KEY=

# LINE second factor (scripts/line-bind-verified.sql).
#
# LINE_LOGIN_CHANNEL_ID is the channel id of the LINE **Login** channel that
# owns the /verify/ LIFF app — NOT the Messaging API channel above. It is sent
# as `client_id` to https://api.line.me/oauth2/v2.1/verify, which is how LINE
# checks the ID token's audience. Without it /line/bind cannot verify anything
# and every bind fails.
#
# PREREQUISITE: the LIFF app also needs the `openid` scope, or
# liff.getIDToken() returns null in the browser. getProfile() only needs
# `profile`, so this most likely has to be turned on in the LINE Developers
# console before any of this works.
LINE_LOGIN_CHANNEL_ID=

# Staged rollout. Leave unset (detect-only) until /verify/ is observed
# completing real binds in production:
#   select count(*) from public.line_verified_sessions
#   where verified_at > now() - interval '1 day';
# Set to "true" to ENFORCE — gated pages then require that the current session
# proved its LINE identity, and the bind fail-opens are switched off.
LINE_BIND_ENFORCE=

# Local dev only — Vercel provides PORT automatically
# PORT=3000

# ─────────────────────────────────────────────────────────────
# Drive destinations for the process/ pipeline (GitHub Actions secrets)
# ─────────────────────────────────────────────────────────────
# Both were hardcoded in process/*.js while this repository was public, which
# published a direct address for two folders shared "anyone with the link".
# A folder id is a locator rather than a secret, so moving it here is hygiene —
# what actually closes the exposure is removing the public sharing on the
# folders themselves. Both scripts now exit non-zero when the value is missing
# rather than defaulting somewhere unintended.
#
# P4P_REPORT_FOLDER_ID=      # process/report.js — outstanding-submissions list
# P4P_ELIGIBLE_FOLDER_ID=    # process/eligible-list.js — monthly eligible PDF

# ─────────────────────────────────────────────────────────────
# Only for the admin scripts in scripts/ (NOT needed by the app)
# ─────────────────────────────────────────────────────────────
# LINE_TOKEN=        # setup-richmenu.mjs, update-month-picker.mjs
# LINE_USER_ID=      # send-test-flex.mjs
