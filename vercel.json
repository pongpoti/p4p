{
  "version": 2,
  "builds": [
    {
      "src": "main.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["list/**", "status/**", "ranking/**", "verify/**", "admin/**", "dashboard/**", "assets/**", "upload/**", "lib/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.ts"
    }
  ]
}