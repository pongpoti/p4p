{
  "version": 2,
  "builds": [
    {
      "src": "main.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["list/**", "status/**", "ranking/**", "verify/**", "admin/**", "assets/**", "upload/**", "lib/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.js"
    }
  ]
}