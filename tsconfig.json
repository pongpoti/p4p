{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["main.ts", "lib/*.ts", "src/**/*.ts", "scripts/**/*.mts"],
  "exclude": ["node_modules", "web", "automation", "process", "lib/line-receipt-flex.ts"]
}
