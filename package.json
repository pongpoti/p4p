{
  "name": "p4p",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "tsx main.ts",
    "test": "tsx --test lib/__tests__/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@line/bot-sdk": "^10.6.0",
    "axios": "^1.13.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "sharp": "^0.35.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.15.0"
  }
